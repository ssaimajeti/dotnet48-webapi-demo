<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="Sso:AllowedRedirectUris" value="https://app.example.com/callback;https://portal.example.com/auth/cb" />
    <add key="Sso:HonorXForwardedProto" value="false" />
  </appSettings>
  <system.diagnostics>
    <trace>
      <listeners>
        <add name="SsoAuditLog" type="System.Diagnostics.TextWriterTraceListener" initializeData="App_Data/Logs/sso-audit.log" />
        <remove name="Default" />
      </listeners>
    </trace>
  </system.diagnostics>
</configuration>